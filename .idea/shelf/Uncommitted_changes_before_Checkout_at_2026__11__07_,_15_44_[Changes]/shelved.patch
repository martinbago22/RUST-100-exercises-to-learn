+++ b/exercises/02_basic_calculator/05_factorial/src/lib.rs	(date 1793891726318)
@@ -9,6 +9,16 @@
 // `factorial(2)` to return `2`, and so on.
 //
 // Use only what you learned! No loops yet, so you'll have to use recursion!
+fn factorial(n: u32) -> u32 {
+    if n == 0 {
+        1
+    } else if n == 1 || n == 2 {
+        n
+    } else {
+        n * factorial(n - 1)
+    }
+}
